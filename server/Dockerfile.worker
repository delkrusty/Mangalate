ARG TORCH_IMAGE=pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime
ARG ROCM_IMAGE=rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1
FROM python:3.13-slim AS cpu
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git g++ ffmpeg libsm6 libxext6 libgl1 libglib2.0-0 libvulkan1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG UPSTREAM_REV=d6de6ab62a7be6afc0d07a3184149cdefbcd32f2
RUN git clone https://github.com/zyddnys/manga-image-translator.git . && git checkout "$UPSTREAM_REV"
RUN python -c "from pathlib import Path;p=Path('requirements.txt');s=p.read_text();p.write_text('\n'.join(x for x in s.splitlines() if not x.startswith(('torch==','torchvision=='))).replace('@fix/python313-cython3','@3ca3d8f0cbd9701f4a765f97fbad43f9b2fe80a6'))"
RUN pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements.txt
COPY worker.py /mangalate/worker.py
COPY core.py /mangalate/core.py
COPY engine_compat.py /mangalate/engine_compat.py
COPY quality.py /mangalate/quality.py
COPY providers.py /mangalate/providers.py
COPY seams.py /mangalate/seams.py
COPY lettering.py /mangalate/lettering.py
COPY memory.py /mangalate/memory.py
COPY speed.py /mangalate/speed.py
COPY profiles /mangalate/profiles
COPY fonts /mangalate/fonts
COPY words /mangalate/words
COPY gateway.py /mangalate/gateway.py
COPY colab/batch.py /mangalate/batch.py
ENV PYTHONPATH=/app
ENTRYPOINT ["python", "/mangalate/worker.py"]

FROM ${ROCM_IMAGE} AS rocm
# Experimental: preserve the AMD torch/torchvision builds. Do not pip-replace them
# with CUDA wheels. Offline translation is forced to CPU by --use-gpu-limited.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git g++ ffmpeg libsm6 libxext6 libgl1 libglib2.0-0 libvulkan1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG UPSTREAM_REV=d6de6ab62a7be6afc0d07a3184149cdefbcd32f2
RUN git clone https://github.com/zyddnys/manga-image-translator.git . && git checkout "$UPSTREAM_REV"
RUN python -c "from pathlib import Path;p=Path('requirements.txt');s=p.read_text();p.write_text('\n'.join(x for x in s.splitlines() if not x.startswith(('torch==','torchvision=='))).replace('@fix/python313-cython3','@3ca3d8f0cbd9701f4a765f97fbad43f9b2fe80a6'))" && pip install --no-cache-dir -r requirements.txt
COPY worker.py /mangalate/worker.py
COPY core.py /mangalate/core.py
COPY engine_compat.py /mangalate/engine_compat.py
COPY quality.py /mangalate/quality.py
COPY providers.py /mangalate/providers.py
COPY seams.py /mangalate/seams.py
COPY lettering.py /mangalate/lettering.py
COPY memory.py /mangalate/memory.py
COPY speed.py /mangalate/speed.py
COPY profiles /mangalate/profiles
COPY fonts /mangalate/fonts
COPY words /mangalate/words
COPY gateway.py /mangalate/gateway.py
COPY colab/batch.py /mangalate/batch.py
ENV PYTHONPATH=/app
ENTRYPOINT ["python", "/mangalate/worker.py"]

FROM ${TORCH_IMAGE} AS gpu
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git g++ ffmpeg libsm6 libxext6 libgl1 libglib2.0-0 libvulkan1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG UPSTREAM_REV=d6de6ab62a7be6afc0d07a3184149cdefbcd32f2
RUN git clone https://github.com/zyddnys/manga-image-translator.git . && git checkout "$UPSTREAM_REV"
# The base image's Python is marked "externally managed" (PEP 668); this image is the
# whole environment, so pip may install into it. Keep the image's CUDA torch builds.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN python -c "from pathlib import Path;p=Path('requirements.txt');s=p.read_text();p.write_text('\n'.join(x for x in s.splitlines() if not x.startswith(('torch==','torchvision=='))).replace('@fix/python313-cython3','@3ca3d8f0cbd9701f4a765f97fbad43f9b2fe80a6'))" && pip install --no-cache-dir -r requirements.txt
COPY worker.py /mangalate/worker.py
COPY core.py /mangalate/core.py
COPY engine_compat.py /mangalate/engine_compat.py
COPY quality.py /mangalate/quality.py
COPY providers.py /mangalate/providers.py
COPY seams.py /mangalate/seams.py
COPY lettering.py /mangalate/lettering.py
COPY memory.py /mangalate/memory.py
COPY speed.py /mangalate/speed.py
COPY profiles /mangalate/profiles
COPY fonts /mangalate/fonts
COPY words /mangalate/words
COPY gateway.py /mangalate/gateway.py
COPY colab/batch.py /mangalate/batch.py
ENV PYTHONPATH=/app
ENTRYPOINT ["python", "/mangalate/worker.py"]
