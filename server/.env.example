# Prefer python setup.py: it creates these files and prints the app instructions.
MANGALATE_PROFILE=basic
MANGALATE_BIND=127.0.0.1
MANGALATE_KEY_FILE=./secrets/mangalate_key.txt
MANGALATE_API_KEY_FILE=./secrets/provider_key.txt
MANGALATE_ALLOW_ART_TEXT=false
# quality (padrão) ou fast (mais leve em CPU)
MANGALATE_SPEED=quality
# Only BYOK; API key itself is in provider_key.txt, not this file or the app.
CUSTOM_OPENAI_API_BASE=https://api.deepseek.com/v1
CUSTOM_OPENAI_MODEL=deepseek-chat
# Public VPS only: your DNS domain, not an IP.
MANGALATE_DOMAIN=
