# Copie para .env e preencha só o que for usar.

# Chave que o app envia (Configurações › Mangalate › Chave de acesso).
# Obrigatória: sem ela o servidor recusa as páginas.
MANGALATE_KEY=troque-por-uma-senha-longa

# Motores de tradução (preencha o do motor escolhido no app)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DEEPL_AUTH_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Para "Compatível OpenAI" (Ollama, LM Studio, OpenRouter...)
CUSTOM_OPENAI_API_BASE=http://host.docker.internal:11434/v1
CUSTOM_OPENAI_MODEL=
CUSTOM_OPENAI_API_KEY=
